  "cards": [
    {
      "dot": "cyan",
      "title": "Local runtime",
      "items": [
        "One process: one capture owner, 32 pending analysis jobs, one active qualifier.",
        "Optional SIGNOFF_TOKEN; CSRF on writes; /live/ws for optional clients."
      ]
    },
    {
      "dot": "violet",
      "title": "Evidence separation",
      "items": [
        "Reference labels never enter inference.",
        "Originals, reviews and frozen reports retain separate identities; hashes prove integrity, not external authenticity."
      ]
    },
    {
      "dot": "amber",
      "title": "Physical acceptance remains pending",
      "items": [
        "Real station data, 100 inactivity episodes, a two-hour soak and explicit OWNER acceptance are required.",
        "Signoff does not control robots or train policies."
      ]
    }
  ]
